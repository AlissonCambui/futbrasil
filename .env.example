# Copie este arquivo para ".env" (sem o ".example") e preencha com seus
# próprios valores. O arquivo ".env" nunca deve ser enviado ao GitHub —
# ele já está listado no .gitignore por segurança.
#
# Estas variáveis ainda NÃO são usadas pelo app (ver src/api/footballApi.js).
# Elas ficam aqui prontas para quando você conectar o backend/função
# serverless que vai falar com a API de futebol.

VITE_API_FOOTBALL_KEY=coloque_sua_chave_aqui
